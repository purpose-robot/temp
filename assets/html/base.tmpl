{{define "base"}}
<!doctype html>
<html lang='en'>
    <head>
        <meta charset='utf-8'>
        <title>{{template "page:title" .}}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {{block "page:meta" .}}{{end}}

        <link rel='stylesheet' href='/static/css/webawesome.css'>
    </head>
    <body>
        <header>
            {{template "partial:header" .}}
        </header>
        <main>
            {{template "page:main" .}}
        </main>
        <footer>
            {{template "partial:footer" .}}
        </footer>
    </body>
</html>
{{end}}
